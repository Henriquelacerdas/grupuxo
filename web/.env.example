# Reveza Web: variáveis de ambiente. Nada aqui é segredo, exceto SESSION_SECRET.
# Copie para .env.local (dev) ou configure no projeto da Vercel.

# Endereço da `api` (Function URL do ambiente). Dev local: o servidor de backend/tools/local-api.
REVEZA_API_BASE_URL=http://127.0.0.1:4010
# REVEZA_API_BASE_URL=https://oxq6xfm2bjp6m5tx67y3csoy3y0sjvvu.lambda-url.us-east-1.on.aws

# Cognito (IDs públicos, os mesmos do app iOS em grupuxo/grupuxo/amplify_outputs.json).
COGNITO_USER_POOL_ID=us-east-1_M9GpISkE3
COGNITO_CLIENT_ID=21gqeeehhmeufpipk84e3cc7tu
# Só para dev/e2e: o emulador do backend/tools/local-api. Em produção, deixe vazio (usa cognito-idp.<região>.amazonaws.com).
COGNITO_ENDPOINT=http://127.0.0.1:4010/cognito

# Segredo para cifrar o refresh token e assinar o cookie de perfil. 32+ bytes aleatórios:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=troque-por-um-valor-aleatorio-de-32-bytes-ou-mais

# Web Push (chave pública VAPID, gerada por backend/tools/webpush-keys). Sem valor, o web não oferece push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Links públicos (sem valor, o item some, como no app).
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PRIVACY_POLICY_URL=https://henriquelacerdas.github.io/reveza-privacy/
NEXT_PUBLIC_TERMS_URL=https://henriquelacerdas.github.io/reveza-privacy/terms.html
NEXT_PUBLIC_FEEDBACK_EMAIL=reveza.app@gmail.com

# Versão mostrada em Ajustes › Sobre (opcional; sem valor, a do package.json).
NEXT_PUBLIC_APP_VERSION=
