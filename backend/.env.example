# Servidor local de demonstração (sem AWS): copie para `.env` e preencha. `npm run start:local`.
# `.env` e `data/` não vão para o git.

PORT=8787
# Arquivo do banco (um único JSON). Faça cópia dele para fazer backup.
DB_PATH=data/db.json

# Meta (WhatsApp Cloud API)
VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v25.0
# Número do bot, só dígitos (o link wa.me do app usa este número)
BOT_PHONE_NUMBER=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Limite de mensagens por número
RATE_LIMIT_MAX_MESSAGES=10
RATE_LIMIT_WINDOW_SECONDS=60

# Cognito do app (valores públicos; o servidor só valida tokens pelo JWKS público)
COGNITO_USER_POOL_ID=us-east-1_M9GpISkE3
COGNITO_CLIENT_ID=
