{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Photos",
      "Effect": "Allow",
      "Action": [
        "s3:*Bucket*",
        "s3:*EncryptionConfiguration",
        "s3:*LifecycleConfiguration",
        "s3:GetAccelerateConfiguration",
        "s3:GetReplicationConfiguration"
      ],
      "Resource": "arn:aws:s3:::grupuxo-dev-photos"
    },
    {
      "Sid": "Rule",
      "Effect": "Allow",
      "Action": "events:*",
      "Resource": "arn:aws:events:us-east-1:580100736070:rule/grupuxo-dev-*"
    },
    {
      "Sid": "Roles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:List*Role*",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": "arn:aws:iam::580100736070:role/grupuxo-dev-*"
    },
    {
      "Sid": "Pass",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::580100736070:role/grupuxo-dev-*",
      "Condition": {"StringEquals": {"iam:PassedToService": "lambda.amazonaws.com"}}
    },
    {
      "Sid": "Fn",
      "Effect": "Allow",
      "Action": "lambda:*",
      "Resource": "arn:aws:lambda:us-east-1:580100736070:function:grupuxo-dev-*"
    },
    {
      "Sid": "Any",
      "Effect": "Allow",
      "Action": [
        "lambda:*EventSourceMapping*",
        "lambda:*Tag*",
        "logs:DescribeLogGroups"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:*RetentionPolicy",
        "logs:*Tag*"
      ],
      "Resource": "arn:aws:logs:us-east-1:580100736070:log-group:/aws/lambda/grupuxo-dev-*"
    },
    {
      "Sid": "Alarm",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:*Tag*"
      ],
      "Resource": "arn:aws:cloudwatch:us-east-1:580100736070:alarm:grupuxo-dev-*"
    }
  ]
}
